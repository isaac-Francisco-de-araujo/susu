# Frontend: URL base da API. Em desenvolvimento, /api usa o proxy Vite.
VITE_API_URL=/api

# Proxy de desenvolvimento; não é usado no frontend publicado.
BACKEND_URL=http://127.0.0.1:8080

# Consulta SSR do frontend (URL completa incluindo /api; configurar no servidor publicado).
# SERVER_API_URL=https://sua-api.example.com/api

# Em produção, prefira /api encaminhado à API pelo servidor do mesmo domínio.
# Frontend e API precisam estar no mesmo site para o cookie SameSite=Strict.
# Para subdomínios do mesmo site, defina VITE_API_URL e CORS_ALLOWED_ORIGINS explicitamente.

# Backend Java (definir no ambiente do processo Java, não é lido automaticamente daqui):
# ADMIN_USERNAME=admim
# ADMIN_PASSWORD=<senha-forte-exclusiva>
# Sem ADMIN_PASSWORD, a senha temporária aparece somente no terminal do backend.
# SESSION_COOKIE_SECURE=true # obrigatório na publicação por HTTPS
# UPLOAD_DIRECTORY=./data/uploads
